# Copia a .env (no lo subas a git) y cambia los valores.
DB_NAME=nearby
DB_USER=nearby
DB_PASSWORD=cambia-esta-clave
# 32 caracteres o más. Genera uno con: openssl rand -base64 48
NEARBY_JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
NEARBY_SMS_INBOUND_TOKEN=cambia-este-token
NEARBY_CORS_ORIGINS=https://tu-app-web.example
# prod = sin datos demo. prod,demo = carga la Zona 3 · Las Flores para la presentación.
SPRING_PROFILES_ACTIVE=prod,demo
# Solo para la demo: código SMS fijo. Déjalo vacío en un despliegue real.
NEARBY_OTP_DEV_CODE=
NEARBY_SWAGGER_ENABLED=true
# IA real (opcional): anthropic + tu API key. Por defecto, reglas.
NEARBY_AI_PROVIDER=rules
ANTHROPIC_API_KEY=
PORT=8080
