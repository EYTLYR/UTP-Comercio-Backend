# Copia a .env (no lo subas a git) y llena los valores. Formato KEY=valor, sin comillas.
# Lo leen Spring Boot (al correr con ./mvnw) y docker compose -f compose.prod.yaml --env-file .env.

# --- Neon PostgreSQL (Connection string del panel de Neon, en formato JDBC) ---
# App: host con -pooler. Migraciones (Flyway): el mismo host sin -pooler.
DB_URL=jdbc:postgresql://ep-xxxx-pooler.c-9.us-east-2.aws.neon.tech/utp_comercio_db?sslmode=require&channelBinding=require
DB_MIGRATION_URL=jdbc:postgresql://ep-xxxx.c-9.us-east-2.aws.neon.tech/utp_comercio_db?sslmode=require&channelBinding=require
DB_USER=neondb_owner
DB_PASSWORD=cambia-esta-clave

# --- Neon Object Storage (S3 compatible): fotos de los reportes de riesgo ---
NEARBY_STORAGE_PROVIDER=s3
NEARBY_S3_BUCKET=nearby
AWS_ENDPOINT_URL_S3=https://br-xxxx.storage.c-9.us-east-2.aws.neon.tech
AWS_ACCESS_KEY_ID=nak_live_xxxx
AWS_SECRET_ACCESS_KEY=nsk_live_xxxx
AWS_REGION=us-east-2

# --- SMS reales: microservicio SMS (micro/sms-gateway, celular Android con SMS Gateway) ---
# console = solo log. http = envío real por HTTP al microservicio compartido del equipo, con 2 reintentos
# ("gateway" es el nombre anterior y sigue funcionando)
# (https://fflx84lw-3000.brs.devtunnels.ms, ya es el valor por defecto). La clave pídesela a James; no la subas a git.
NEARBY_SMS_PROVIDER=console
NEARBY_SMS_GATEWAY_API_KEY=

# --- App ---
# 32 caracteres o más. Genera uno con: openssl rand -base64 48
NEARBY_JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
NEARBY_SMS_INBOUND_TOKEN=cambia-este-token
NEARBY_CORS_ORIGINS=https://tu-app-web.example
# Solo docker compose. La base arranca vacía: solo la zona, sus calles y puntos seguros.
SPRING_PROFILES_ACTIVE=prod
# Municipalidad (ADMIN) y brigada (BRIGADIST) por celular, separados por coma. Se aplican al ingresar.
NEARBY_ADMIN_PHONES=
NEARBY_BRIGADE_PHONES=
# Solo para la demo: código SMS fijo. Déjalo vacío en un despliegue real.
NEARBY_OTP_DEV_CODE=
NEARBY_SWAGGER_ENABLED=true
# IA real (opcional). rules = sin IA (por defecto); anthropic = Claude; gemini = Gemini (foto de riesgo y
# micrófono). Si la IA falla o tarda, responde el analizador de reglas: el vecino nunca ve un error.
NEARBY_AI_PROVIDER=rules
ANTHROPIC_API_KEY=
# Clave de Google AI Studio (https://aistudio.google.com/apikey). No la subas a git.
GEMINI_API_KEY=
# NEARBY_GEMINI_MODEL=gemini-2.5-flash
PORT=8080
