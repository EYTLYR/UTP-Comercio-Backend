# Copia a .env y llena con los datos de la app SMS Gateway (pestaña Home, "Cloud server").
SMSGATE_USERNAME=
SMSGATE_PASSWORD=
# Opcional: app -> Settings -> Webhooks -> Signing Key. Si está, se rechazan webhooks sin firma válida.
SMSGATE_SIGNING_KEY=
PORT=3000

# --- Microservicio: lo consume el backend Nearby
# Clave que el backend manda en X-Api-Key (igual a NEARBY_SMS_GATEWAY_API_KEY del backend).
# Genera una con: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
SERVICE_API_KEY=
# SMS recibidos -> backend (FORWARD_TOKEN igual a NEARBY_SMS_INBOUND_TOKEN del backend).
FORWARD_URL=http://localhost:8080/api/v1/sms/inbound
FORWARD_TOKEN=
# Página de prueba en / (false si el servicio queda público en internet).
DEMO_UI=true
